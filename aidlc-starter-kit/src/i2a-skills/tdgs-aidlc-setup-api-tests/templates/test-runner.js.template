const AsyncFunction = Object.getPrototypeOf(async function () {}).constructor;

// Sync sleep without CPU spin (Atomics.wait blocks the thread without busy-loop). Required
// because persistCatalogStatus() is called from a sync code path.
const _waitBuf = new Int32Array(new SharedArrayBuffer(4));
function syncSleep(ms) { Atomics.wait(_waitBuf, 0, 0, Math.max(1, ms | 0)); }

function tryStealStaleLock(lockPath) {
  // Returns true if a stale lock was removed (holder PID dead OR lock > 120s old).
  try {
    const lockContent = fs.readFileSync(lockPath, 'utf8');
    const lockPid = parseInt(lockContent.split('\n')[0], 10);
    const lockTime = parseInt(lockContent.split('\n')[1], 10);
    let pidAlive = true;
    try { process.kill(lockPid, 0); } catch { pidAlive = false; }
    if (!pidAlive || (Date.now() - lockTime > 120000)) {
      console.warn(`[CATALOG] Removing stale lock (pid=${lockPid} alive=${pidAlive}, age=${Date.now() - lockTime}ms)`);
      try { fs.unlinkSync(lockPath); return true; } catch { return false; }
    }
  } catch { /* lock unreadable or already gone */ }
  return false;
}

function acquireCatalogLock(lockPath, timeoutMs) {
  // Stale-lock peek BEFORE wait loop (recovery path for crashed runners).
  const start = Date.now();
  try { fs.writeFileSync(lockPath, `${process.pid}\n${Date.now()}`, { flag: 'wx' }); return; }
  catch (e) {
    if (tryStealStaleLock(lockPath)) {
      try { fs.writeFileSync(lockPath, `${process.pid}\n${Date.now()}`, { flag: 'wx' }); return; } catch {}
    }
  }
  while (true) {
    try { fs.writeFileSync(lockPath, `${process.pid}\n${Date.now()}`, { flag: 'wx' }); return; }
    catch (e) {
      if (Date.now() - start > timeoutMs) {
        if (tryStealStaleLock(lockPath)) {
          try { fs.writeFileSync(lockPath, `${process.pid}\n${Date.now()}`, { flag: 'wx' }); return; } catch {}
        }
        throw new Error(`Catalog lock held > ${timeoutMs}ms: ${lockPath}`);
      }
      // Backoff 50-150ms (zero-delay spin starves holder; spin loop pegs core to 100%).
      syncSleep(50 + Math.floor(Math.random() * 100));
    }
  }
}

function persistCatalogStatus(poolData) {
  if (!poolData || !poolData.catalogPath) return;
  const lockPath = poolData.catalogPath + '.lock';
  const tmpPath = poolData.catalogPath + '.tmp';
  acquireCatalogLock(lockPath, 30000);
  try {
    // READ-MERGE-WRITE (MANDATORY): re-read the catalog INSIDE the lock so concurrent
    // service runners don't clobber each other's pool status updates.
    // Only merge records this run actually touched (identified by lastUsedRunId === poolData._runId).
    let diskCatalog = poolData.catalog;
    try {
      const freshRaw = fs.readFileSync(poolData.catalogPath, 'utf8');
      diskCatalog = yaml.load(freshRaw);
      if (diskCatalog?.identityPools && poolData.catalog?.identityPools) {
        for (const memPool of poolData.catalog.identityPools) {
          const memKey = memPool.poolType || memPool.type;
          const diskPool = diskCatalog.identityPools.find(p => (p.poolType || p.type) === memKey);
          if (!diskPool?.records) continue;
          for (const memRec of memPool.records || []) {
            if (!memRec.lastUsedRunId || memRec.lastUsedRunId !== poolData._runId) continue;
            const diskRec = diskPool.records.find(dr =>
              dr.fields && memRec.fields && JSON.stringify(dr.fields) === JSON.stringify(memRec.fields));
            if (!diskRec) continue;
            // DELTA-MERGE: apply this run's increments additively on top of disk values
            // (NOT absolute assignment — that loses concurrent writers' updates).
            const memKeyForSnap = (memPool.poolType || memPool.type) + ':' + JSON.stringify(memRec.fields ?? {});
            const initial = poolData._initialSnapshot?.[memKeyForSnap] || { consumedCount: 0, failureCount: 0, consecutiveFailureCount: 0 };
            const deltaConsumed = (memRec.consumedCount ?? 0) - (initial.consumedCount ?? 0);
            const deltaFailure  = (memRec.failureCount  ?? 0) - (initial.failureCount  ?? 0);
            diskRec.consumedCount = Math.max(0, (diskRec.consumedCount ?? 0) + deltaConsumed);
            diskRec.failureCount  = Math.max(0, (diskRec.failureCount  ?? 0) + deltaFailure);
            // consecutiveFailureCount: any pass in this run zeroes it; failures-only adds.
            if (deltaConsumed > 0 && deltaFailure === 0) {
              diskRec.consecutiveFailureCount = 0;
            } else if (deltaFailure > 0) {
              diskRec.consecutiveFailureCount = (diskRec.consecutiveFailureCount ?? 0) + deltaFailure;
            }
            // Re-evaluate quarantine against MERGED disk values.
            const threshold = (memPool.quarantineThreshold ?? diskPool.quarantineThreshold ?? 5);
            if ((diskRec.consecutiveFailureCount ?? 0) >= threshold) {
              diskRec.status = 'quarantined';
              if (memRec.lastFailedReason) diskRec.lastFailedReason = memRec.lastFailedReason;
            } else if (deltaConsumed > 0) {
              if (diskRec.status !== 'quarantined') diskRec.status = 'available';
            }
            diskRec.lastUsedAt = memRec.lastUsedAt;
            diskRec.lastUsedRunId = memRec.lastUsedRunId;
          }
          if (memPool._rotationIndex != null) {
            // R10-C6: DELTA-MERGE _rotationIndex (NOT absolute) — preserves monotonic forward
            // progression across concurrent writers. Index is mod available.length on read.
            const initialIdx = poolData._initialSnapshot?.[`${memKey}::_rotationIndex`] ?? 0;
            const deltaIdx   = (memPool._rotationIndex ?? 0) - initialIdx;
            diskPool._rotationIndex = (diskPool._rotationIndex ?? 0) + Math.max(0, deltaIdx);
          }
        }
      }
    } catch (readErr) {
      console.warn(`[CATALOG] Could not re-read inside lock (${readErr.message}), writing in-memory snapshot`);
      diskCatalog = poolData.catalog;
    }
    fs.writeFileSync(tmpPath, yaml.dump(diskCatalog, { lineWidth: 120 }), 'utf8');
    const fd = fs.openSync(tmpPath, 'r+'); fs.fsyncSync(fd); fs.closeSync(fd);
    fs.renameSync(tmpPath, poolData.catalogPath);
    console.log(`[CATALOG] Persisted pool status updates to ${poolData.catalogPath}`);
  } finally { try { fs.unlinkSync(lockPath); } catch {} }
}
