#!/usr/bin/env node
'use strict';
/**
 * Insomnia collection linter — reference template (G16 LINT-1..12).
 * Usage: node scripts/lint-collection.js collections/*.json
 */
const fs = require('fs');
const path = require('path');
const yaml = require('js-yaml');

const ROOT = path.resolve(__dirname, '..');
const ATTACK_RES = [
  /('\s*OR\s*'1'\s*=\s*'1|--\s*$|;\s*DROP\s+TABLE|UNION\s+SELECT|;\s*DELETE\s+FROM)/i,
  /<\s*script|<\s*img[^>]*onerror|javascript:|on(load|error|click)\s*=|<\s*iframe/i,
  /\.\.\/|\.\.\\/,
  /[\x00-\x08\x0B\x0C\x0E-\x1F]/,
  /^(TEST|FOO|BAR|XXX|TODO|PLACEHOLDER|UNDEFINED|NULL|NaN|\?\?\?)$/i,
  /<\/?[a-z][\s\S]*?>/i,
];
const PII_NAME = /firstName|fName|givenName|lastName|lName|surname|familyName|fullName/i;
const ENGLISH_NAMES = /^(JOHN|JANE|JOHNNY|JOHNATHAN|JANEY|DOE|DOES|SMITH|JONES|BROWN|TEST|TESTUSER|USER|BABY|DECEDENT|NAME|FIRSTNAME|LASTNAME)$/i;
const ALLOWED_TOKEN =
  /^\{\{(catalog\.identityPool\.[^.]+\.[^}]+|catalog\.stubs\.[^.]+\.[^}]+|captured\.[^}]+|\$[a-zA-Z]+)\}\}$/;

function loadJson(p) {
  return JSON.parse(fs.readFileSync(p, 'utf8'));
}

function loadCatalog() {
  const ws = path.resolve(ROOT, '..', '..');
  try {
    for (const e of fs.readdirSync(ws)) {
      if (!e.includes('-docs')) continue;
      const c = path.join(ws, e, 'test-data', 'test-data-catalog.yaml');
      if (fs.existsSync(c)) return yaml.load(fs.readFileSync(c, 'utf8'));
    }
  } catch (_) {}
  return null;
}

function loadAssertionContract() {
  const p = path.join(ROOT, 'config', 'assertion-contract.json');
  if (!fs.existsSync(p)) return { methods: [] };
  return loadJson(p);
}

function loadFieldMaps() {
  const req = path.join(ROOT, 'config', 'field-required-map.json');
  const fmt = path.join(ROOT, 'config', 'field-format-map.json');
  return {
    required: fs.existsSync(req) ? loadJson(req) : {},
    format: fs.existsSync(fmt) ? loadJson(fmt) : {},
  };
}

function walkResources(collection, fn) {
  for (const r of collection.resources || []) fn(r);
}

function collectTokens(text) {
  const out = [];
  const re = /\{\{[^}]+\}\}/g;
  let m;
  while ((m = re.exec(text || ''))) out.push(m[0]);
  return out;
}

function isPositiveFolder(name, meta) {
  return /Positive/i.test(name || '') || meta?.caseType === 'positive';
}

function lintCollection(file, catalog, contract, maps) {
  const errors = [];
  const col = loadJson(file);
  const allowedMethods = new Set(contract.methods || []);

  walkResources(col, (r) => {
    if (r._type === 'unit_test' && r.code) {
      if (/_skipReason/.test(JSON.stringify(r))) {
        errors.push(`${file}: _skipReason forbidden on ${r.name}`);
      }
      const calls = r.code.match(/expect\([^)]*\)\.(\w+(?:\.\w+)*)/g) || [];
      for (const c of calls) {
        const method = c.replace(/expect\([^)]*\)\./, '');
        if (allowedMethods.size && !allowedMethods.has(method)) {
          errors.push(`${file}: LINT-1 unknown assertion in ${r.name}: ${method}`);
        }
      }
    }
    if (r._type !== 'request') return;
    const folder = r.meta?.folder || r.name || '';
    const body = r.body?.text || '';
    const url = r.url || '';
    const positive = isPositiveFolder(folder, r.meta);

    for (const tok of collectTokens(`${url}\n${body}`)) {
      if (!ALLOWED_TOKEN.test(tok) && !/^\{\{\s*[a-zA-Z0-9_]+\s*\}\}$/.test(tok)) {
        if (!tok.startsWith('{{catalog.') && !tok.startsWith('{{captured.') && !tok.startsWith('{{$')) {
          errors.push(`${file}: LINT-2 invalid token ${tok} in ${r.name}`);
        }
      }
      const cm = tok.match(/\{\{catalog\.identityPool\.([^.]+)\.([^}]+)\}\}/);
      if (cm && catalog?.identityPools) {
        const pool = catalog.identityPools.find((p) => (p.poolType || p.type) === cm[1]);
        if (!pool) errors.push(`${file}: LINT-3 unknown pool ${cm[1]} in ${r.name}`);
        else if (!pool.fields?.includes(cm[2])) {
          errors.push(`${file}: LINT-3 pool ${cm[1]} missing field ${cm[2]}`);
        }
      }
    }

    if (positive && body) {
      let probe = body.replace(/\{\{captured\.[^}]+\}\}/g, '"PLACEHOLDER"');
      probe = probe.replace(/\{\{[^}]+\}\}/g, '""');
      let parsed = null;
      if ((r.body?.mimeType || '').includes('json')) {
        try {
          parsed = JSON.parse(probe.length ? probe : '{}');
        } catch (e) {
          errors.push(`${file}: LINT-4 JSON parse after substitution in ${r.name}: ${e.message}`);
        }
      } else {
        try { parsed = JSON.parse(probe.length ? probe : '{}'); } catch (_) {}
      }
      for (const re of ATTACK_RES) {
        if (re.test(body) && !/\/Negative\/Security\//i.test(folder)) {
          errors.push(`${file}: LINT-7 attack payload in positive ${r.name}`);
        }
      }
      if (parsed) {
        walkJsonLeaves(parsed, '', (field, val) => {
          if (typeof val !== 'string') return;
          if (PII_NAME.test(field) && ENGLISH_NAMES.test(val)) {
            errors.push(`${file}: LINT-9 literal name ${val} on ${field} in ${r.name}`);
          }
          // LINT-5: Reject literal values that match a stub token (bypass detection)
          if (catalog?.stubs) {
            for (const [svc, fields] of Object.entries(catalog.stubs)) {
              if (fields[field] !== undefined && val === String(fields[field]) && val !== '') {
                errors.push(`${file}: LINT-5 literal stub bypass — field "${field}" uses hardcoded value "${val}" instead of catalog token in ${r.name}`);
              }
            }
          }
          // LINT-8: Reject empty string on @NotBlank/@NotNull required fields
          if (val === '' && maps.required[field]) {
            errors.push(`${file}: LINT-8 empty value on required field "${field}" (${maps.required[field]}) in positive ${r.name}`);
          }
          if (catalog?.identityPools) {
            for (const pool of catalog.identityPools) {
              if (pool.fields?.some((f) => f.toLowerCase() === field.toLowerCase())) {
                const expected = `{{catalog.identityPool.${pool.poolType || pool.type}.${field}}}`;
                if (val && val !== expected && !val.includes('{{catalog.')) {
                  errors.push(`${file}: LINT-11 field ${field} should use catalog token in ${r.name}`);
                }
              }
            }
          }
        });
      }
    }
  });

  return errors;
}

function walkJsonLeaves(obj, prefix, fn) {
  if (obj && typeof obj === 'object' && !Array.isArray(obj)) {
    for (const [k, v] of Object.entries(obj)) walkJsonLeaves(v, prefix ? `${prefix}.${k}` : k, fn);
  } else if (Array.isArray(obj)) {
    obj.forEach((v, i) => walkJsonLeaves(v, `${prefix}[${i}]`, fn));
  } else fn(prefix, obj);
}

function main() {
  const files = process.argv.slice(2).filter((f) => f.endsWith('.json'));
  if (!files.length) {
    console.error('Usage: node lint-collection.js collections/*.json');
    process.exit(2);
  }
  const catalog = loadCatalog();
  const contract = loadAssertionContract();
  const maps = loadFieldMaps();
  void maps;
  const all = [];
  for (const f of files) all.push(...lintCollection(path.resolve(f), catalog, contract, maps));
  if (all.length) {
    for (const e of all) console.error('❌', e);
    process.exit(1);
  }
  console.log('LINT-1..12: PASS', files.length, 'collection(s)');
}

main();
