#!/usr/bin/env node
'use strict';
/**
 * API test report generator — reference template ({{SERVICE_NAME}}).
 * Reads test-results/results.json; writes test-summary.html and test-report.md.
 * Contract: ../tools/runner-contract.md
 */
const fs = require('fs');
const path = require('path');

const SERVICE_NAME = '{{SERVICE_NAME}}';
const scriptDir = path.resolve(__dirname, '..');
const resultsPath = path.join(scriptDir, 'test-results', 'results.json');
const prevPath = path.join(scriptDir, 'test-results', 'results.previous.json');
const htmlPath = path.join(scriptDir, 'test-results', 'test-summary.html');
const mdPath = path.join(scriptDir, 'test-results', 'test-report.md');
const ledgerPath = path.join(scriptDir, 'test-results', 'data-ledger.json');

function esc(s) {
  if (s == null) return '';
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function assertSummaryMath(results) {
  const s = results.summary;
  const sumStatuses = s.passed + s.failed + s.skipped + s.dataIssue + s.infra;
  if (sumStatuses !== s.total) {
    throw new Error(
      `results.json summary math broken: passed+failed+skipped+dataIssue+infra=${sumStatuses} != total=${s.total}`
    );
  }
  if (s.executed > s.total) {
    throw new Error(`results.json summary math broken: executed=${s.executed} > total=${s.total}`);
  }
  const counted = { passed: 0, failed: 0, skipped: 0, dataIssue: 0, infra: 0 };
  const statusMap = {
    pass: 'passed',
    fail: 'failed',
    skip: 'skipped',
    'data-issue': 'dataIssue',
    'generation-bug': 'dataIssue',
    'unresolved-token': 'dataIssue',
    infra: 'infra',
  };
  for (const t of results.tests || []) {
    const k = statusMap[t.status] || t.status;
    counted[k] = (counted[k] || 0) + 1;
  }
  for (const k of Object.keys(counted)) {
    if (counted[k] !== s[k]) {
      throw new Error(`Per-test count of ${k}=${counted[k]} does not match summary.${k}=${s[k]}`);
    }
  }
}

function renderMarkdown(results) {
  const s = results.summary;
  let md = `# API Test Report — ${results.service || SERVICE_NAME}\n\n`;
  md += `| Metric | Value |\n|--------|-------|\n`;
  md += `| Pass rate | ${s.passRate}% |\n| Passed | ${s.passed} |\n| Failed | ${s.failed} |\n`;
  md += `| Skipped | ${s.skipped} |\n| Data issues | ${s.dataIssue} |\n| Infra | ${s.infra} |\n\n`;
  const failed = (results.tests || []).filter((t) => t.status === 'fail');
  if (failed.length) {
    md += `## Failed tests\n\n`;
    for (const t of failed) {
      md += `### ${t.name}\n- Endpoint: ${t.endpoint}\n- Error: ${t.error || '—'}\n\n`;
    }
  }
  return md;
}

function renderHtml(results, previous) {
  const s = results.summary;
  const title = esc(results.service || SERVICE_NAME);
  const rate = Number(s.passRate || 0);
  const color = rate >= 90 ? '#27ae60' : rate >= 70 ? '#f39c12' : '#e74c3c';
  let delta = '';
  if (previous?.summary) {
    const prev = previous.summary.passRate || 0;
    delta = `<p>Last run pass rate: ${esc(prev)}% → ${esc(rate)}%</p>`;
  }
  return `<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><title>${title} API Tests</title>
<style>
body{font-family:system-ui,sans-serif;margin:24px;background:#f5f6fa;}
.banner{background:linear-gradient(135deg,#1a5276,#2980b9);color:#fff;padding:20px;border-radius:8px;}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin:16px 0;}
.card{background:#fff;padding:12px;border-radius:6px;box-shadow:0 1px 3px rgba(0,0,0,.08);}
</style></head><body>
<div class="banner"><h1>${title}</h1><p>API Tests — Automated Quality Dashboard</p></div>
${delta}
<div class="cards">
<div class="card"><strong>Pass rate</strong><div style="color:${color};font-size:1.4em">${esc(rate)}%</div></div>
<div class="card"><strong>Passed</strong><div>${esc(s.passed)}</div></div>
<div class="card"><strong>Failed</strong><div>${esc(s.failed)}</div></div>
<div class="card"><strong>Skipped</strong><div>${esc(s.skipped)}</div></div>
<div class="card"><strong>Data issues</strong><div>${esc(s.dataIssue)}</div></div>
<div class="card"><strong>Infra</strong><div>${esc(s.infra)}</div></div>
</div>
<p><em>Generated from results.json — extend this template for Sections 3–10 per tools/runner-contract.md</em></p>
</body></html>`;
}

function main() {
  if (!fs.existsSync(resultsPath)) {
    console.error('Missing', resultsPath);
    process.exit(2);
  }
  const results = JSON.parse(fs.readFileSync(resultsPath, 'utf8'));
  assertSummaryMath(results);
  const previous = fs.existsSync(prevPath) ? JSON.parse(fs.readFileSync(prevPath, 'utf8')) : null;
  fs.writeFileSync(htmlPath, renderHtml(results, previous));
  fs.writeFileSync(mdPath, renderMarkdown(results));
  console.log('Wrote', htmlPath, 'and', mdPath);
  if (fs.existsSync(ledgerPath)) console.log('Ledger present:', ledgerPath);
}

main();
